{
  "name": "@ecom/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "node scripts/generate-client.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "db:reset": "node scripts/db-setup.mjs --reset",
    "db:local": "node scripts/dev-postgres.mjs",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:local:fresh": "node scripts/dev-postgres.mjs --fresh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@prisma/client-generator-ts": "7.10.1",
    "@prisma/internals": "7.10.1",
    "@types/pg": "^8.15.6",
    "embedded-postgres": "18.7.0-beta.19",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "@types/node": "^24.7.2"
  }
}
