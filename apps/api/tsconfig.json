{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": false,
    "paths": {
      "@ecom/types": ["../../packages/types/src/index.ts"],
      "@ecom/validation": ["../../packages/validation/src/index.ts"],
      "@ecom/utils": ["../../packages/utils/src/index.ts"],
      "@ecom/ui": ["../../packages/ui/src/index.ts"],
      "@ecom/db": ["../../packages/db/src/index.ts"]
    },
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "strictBindCallApply": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
