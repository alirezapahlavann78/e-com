# Shared
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecom_aghaci?schema=public

# API
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000,http://localhost:3001
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ADMIN_BOOTSTRAP_EMAIL=admin@aghaci.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!

# Web/Admin
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# S3-compatible storage (MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ecom-aghaci
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/ecom-aghaci
