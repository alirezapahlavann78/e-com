# Shared
NODE_ENV=development

# Database
# Default: the bundled Postgres started with `pnpm db:local` (port 55432).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/ecom_aghaci
# Docker Postgres (infra/docker-compose.yml) instead:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ecom_aghaci?schema=public

# API
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000,http://localhost:3001
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ADMIN_BOOTSTRAP_EMAIL=admin@aghaci.local
ADMIN_BOOTSTRAP_PASSWORD=Admin@12345
# Failed-login lockout (defaults shown). Clear a lock with `pnpm user:unlock`.
# AUTH_LOCKOUT_MAX_ATTEMPTS=5
# AUTH_LOCKOUT_MINUTES=15

# Web/Admin
# Browser calls go through the Next rewrite at /api (same origin); the Next servers
# proxy them to the API using API_INTERNAL_URL.
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://127.0.0.1:4000/api
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Payments
# SANDBOX (default) needs no account: a local confirm page then the real callback path.
# ZARINPAL talks to the real REST v4 API; leave ZARINPAL_SANDBOX=true for its test host.
PAYMENT_PROVIDER=SANDBOX
PAYMENT_AMOUNT_UNIT=TOMAN
# Public base of the API as the browser sees it; used to build provider callback URLs.
API_PUBLIC_URL=http://localhost:4000/api
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Transactional notifications (email + SMS outbox)
# Empty MAIL_HOST -> emails are written as .eml files to MAIL_FILE_DIR.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="آگاهی <no-reply@aghaci.local>"
MAIL_FILE_DIR=uploads/mail
# Empty KAVENEGAR_API_KEY -> SMS text is logged with an [sms:log] prefix.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
NOTIFICATIONS_INTERVAL_MS=15000
NOTIFICATIONS_MAX_ATTEMPTS=5

# Logging: JSON lines by default; LOG_FORMAT=pretty for local reading.
LOG_LEVEL=info
# LOG_FORMAT=pretty
SLOW_REQUEST_MS=1500

# S3-compatible storage (MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ecom-aghaci
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/ecom-aghaci
