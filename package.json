{
  "name": "ecommerce-aghaci",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @ecom/db prisma:generate",
    "db:migrate": "pnpm --filter @ecom/db prisma:migrate",
    "db:seed": "pnpm --filter @ecom/db prisma:seed",
    "setup": "pnpm --filter @ecom/db prisma:generate && pnpm --filter @ecom/db build && pnpm --filter @ecom/db db:setup && pnpm --filter @ecom/db prisma:seed",
    "db:local": "pnpm --filter @ecom/db db:local",
    "db:setup": "pnpm --filter @ecom/db db:setup",
    "db:reset": "pnpm --filter @ecom/db db:reset",
    "db:local:fresh": "pnpm --filter @ecom/db db:local:fresh",
    "user:unlock": "pnpm --filter @ecom/db exec node scripts/account.mjs unlock",
    "user:passwd": "pnpm --filter @ecom/db exec node scripts/account.mjs passwd",
    "user:list": "pnpm --filter @ecom/db exec node scripts/account.mjs list"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
