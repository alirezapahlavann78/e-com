{
  "name": "ecommerce-aghaci",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @ecom/db prisma:generate",
    "db:migrate": "pnpm --filter @ecom/db prisma:migrate",
    "db:seed": "pnpm --filter @ecom/db prisma:seed"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
